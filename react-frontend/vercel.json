{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "VITE_API_BASE_URL": "@vite_api_base_url",
    "VITE_API_AUTH_URL": "@vite_api_auth_url",
    "VITE_API_AUTH_CUSTOMER_URL": "@vite_api_auth_customer_url",
    "VITE_API_AUTH_URL2": "@vite_api_auth_url2",
    "VITE_API_AUTH_URL3": "@vite_api_auth_url3",
    "VITE_URL_IMAGE": "@vite_url_image",
    "VITE_URL_IMAGE_2": "@vite_url_image_2"
  }
}